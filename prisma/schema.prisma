// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Jemaat {
  id         String    @id
  name       String
  address    String
  phone      String
  status     String    @default("AKTIF")
  initials   String
  birthDate  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Transaction {
  id              Int      @id @default(autoincrement())
  transactionDate DateTime
  type            String
  category        String
  amount          Int
  note            String
  createdAt       DateTime @default(now())
}

model User {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  passwordHash   String
  role           String   @default("ADMIN")
  openingBalance Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Ministry {
  id          String   @id
  name        String
  description String
  leader      String
  status      String   @default("AKTIF")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MinistryMember {
  id         String   @id
  ministryId String
  jemaatId   String
  role       String
  joinedAt   DateTime @default(now())
}

model Event {
  id          String   @id
  title       String
  eventDate   DateTime
  description String
  type        String
  createdAt   DateTime @default(now())
}
